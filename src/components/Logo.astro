---
// Marca: un candado partido por una línea (la "brecha") + nombre.
const { tag = true } = Astro.props;
---
<a class="brand" href="/" aria-label="Brecha Cero, portada">
  <svg class="brand-mark" viewBox="0 0 36 36" aria-hidden="true">
    <rect x="0" y="0" width="36" height="36" fill="var(--brand)" />
    <path d="M11 16v-3.5a7 7 0 0 1 14 0V16" fill="none" stroke="#fff" stroke-width="3" />
    <rect x="8" y="16" width="20" height="13" fill="#fff" />
    <path d="M20 13 L15 24 L19 24 L16 33" fill="none" stroke="var(--brand)" stroke-width="2.4" stroke-linejoin="bevel" />
  </svg>
  <span class="brand-name">brecha<span>cero</span></span>
</a>
