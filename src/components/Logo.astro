---
// Marca: palabra "brechacerø". La última letra es un cero tachado (Ø), guiño al
// "cero" del nombre y a la notación de los informáticos para distinguir 0 de O.
interface Props { size?: 'md' | 'sm'; link?: boolean }
const { size = 'md', link = true } = Astro.props;
const Tag = link ? 'a' : 'span';
---
<Tag class={`brand brand-${size}`} href={link ? '/' : undefined} aria-label={link ? 'Brecha Cero, portada' : 'Brecha Cero'}>
  <span class="brand-word" aria-hidden="true">brechacer<svg class="brand-zero" viewBox="0 0 40 52"><ellipse cx="20" cy="27" rx="12.5" ry="16.5" fill="none" stroke="currentColor" stroke-width="7.5"/><path d="M5.5 49 L34.5 5" stroke="currentColor" stroke-width="6.5"/></svg></span>
</Tag>
