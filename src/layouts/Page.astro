---
import Base from './Base.astro';
const { title, description, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="wrap">
    <article class="page">
      <h1 class="h">{title}</h1>
      <div class="prose"><slot /></div>
    </article>
  </div>
</Base>
