---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import Story from '../components/Story.astro';
import Video from '../components/Video.astro';
import { SITE, categoryName } from '../config';
import { getPosts, cover, longDate, readingTime, initials } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const url = `${SITE.url}/${post.id}/`;
const img = cover(post);
const sameCat = all.filter((p) => p.id !== post.id && p.data.category === d.category);
const related = [...sameCat, ...all.filter((p) => p.id !== post.id && p.data.category !== d.category)].slice(0, 4);
const h2 = headings.filter((h) => h.depth === 2);
const enc = encodeURIComponent;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'NewsArticle', headline: d.title, description: d.description, image: [`${SITE.url}${img}`],
      datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
      author: { '@type': 'Person', name: d.author }, mainEntityOfPage: url, inLanguage: 'es',
      publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png`, width: 512, height: 512 } } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Portada', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: categoryName(d.category), item: `${SITE.url}/categoria/${d.category}/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
    ...(d.video ? [{ '@type': 'VideoObject', name: d.videoTitle ?? d.title, thumbnailUrl: `https://i.ytimg.com/vi/${d.video}/hqdefault.jpg`, uploadDate: d.date.toISOString(), embedUrl: `https://www.youtube-nocookie.com/embed/${d.video}` }] : []),
  ],
};
---
<Base title={d.title} description={d.description} image={img} type="article" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="article-head">
      <a class="kicker" href={`/categoria/${d.category}/`}>{categoryName(d.category)}</a>
      <h1 class="h">{d.title}</h1>
      <p class="standfirst">{d.description}</p>
      <div class="meta-bar">
        <div class="author">
          <span class="avatar" aria-hidden="true">{initials(d.author)}</span>
          <span><strong>{d.author}</strong><small><time datetime={d.date.toISOString()}>{longDate(d.date)}</time> · {readingTime(post)} min de lectura</small></span>
        </div>
        <div class="share" aria-label="Compartir">
          <a href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(d.title)}`} rel="noopener" aria-label="Compartir en X"><svg viewBox="0 0 24 24"><path d="M18.2 2h3.4l-7.4 8.5L23 22h-6.8l-5.3-7-6.1 7H1.4l7.9-9L1 2h7l4.8 6.4L18.2 2Zm-1.2 18h1.9L7.1 4H5.1L17 20Z"/></svg></a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} rel="noopener" aria-label="Compartir en LinkedIn"><svg viewBox="0 0 24 24"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm7 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6.1V21h-4v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4V9.5Z"/></svg></a>
          <a href={`https://api.whatsapp.com/send?text=${enc(d.title + ' ' + url)}`} rel="noopener" aria-label="Compartir en WhatsApp"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg></a>
        </div>
      </div>
    </header>
    <figure class="hero-figure">
      <img src={img} alt={d.imageAlt ?? ''} width="1600" height="900" fetchpriority="high" />
      {d.imageCredit && <figcaption>{d.imageCredit}</figcaption>}
    </figure>

    <div class="article-body">
      <div>
        <div class="prose">
          <Content />
          {d.video && <Video id={d.video} title={d.videoTitle} source={d.videoSource} />}
        </div>
        <AdSlot position="inArticle" />
        {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <span>{t}</span>)}</div>}
        <p class="disclaimer"><strong>Nota.</strong> Contamos cómo funcionan las amenazas para que puedas reconocerlas y protegerte. Prueba estas técnicas solo en equipos tuyos o con permiso por escrito: entrar en sistemas ajenos es delito.</p>
      </div>
      <aside class="rail">
        {h2.length >= 3 && (
          <nav class="toc" aria-label="En este artículo">
            <h2>En este artículo</h2>
            <ol>{h2.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="sticky"><AdSlot position="sidebar" /></div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Sigue leyendo</h2></div>
        <div class="grid-4">{related.map((p) => <Story post={p} size="sm" />)}</div>
      </section>
    )}
  </div>
</Base>
